---
interface Props {
  card: {
    src: string;
    title: string;
    category: string;
  };
  index: number;
}

const { card, index } = Astro.props;
---

<div class="last:pr-[5%] md:last:pr-[33%]  rounded-3xl" data-card-wrapper data-card-index={index}>
  <button
    data-card-open
    class="rounded-3xl bg-gray-100 dark:bg-neutral-900 h-80 w-56 md:h-[40rem] md:w-96 overflow-hidden flex flex-col items-start justify-start relative z-10"
  >
    <div class="absolute h-full top-0 inset-x-0 bg-gradient-to-b from-black/50 via-transparent to-transparent z-30 pointer-events-none">
    </div>
    <div class="relative z-40 p-8">
      <p class="text-white text-sm md:text-base font-medium font-sans text-left">
        {card.category}
      </p>
      <p class="text-white text-xl md:text-3xl font-semibold max-w-xs text-left [text-wrap:balance] font-sans mt-2">
        {card.title}
      </p>
    </div>
    <img
      src={card.src}
      alt={card.title}
      loading="lazy"
      decoding="async"
      class="object-cover absolute z-10 inset-0 w-full h-full transition duration-300 blur-sm"
      onload="this.classList.remove('blur-sm')"
    />
  </button>

  <div
    data-card-modal
    class="fixed inset-0 h-screen z-50 overflow-auto hidden"
  >
    <div
      data-card-backdrop
      class="bg-black/80 backdrop-blur-lg h-full w-full fixed inset-0"
    >
    </div>
    <div
      data-card-modal-panel
      class="max-w-5xl mx-auto bg-white dark:bg-neutral-900 h-fit  z-[60] my-10 p-4 md:p-10 rounded-3xl font-sans relative"
    >
      <button
        data-card-close
        class="sticky top-4 h-8 w-8 right-0 ml-auto bg-black dark:bg-white rounded-full flex items-center justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="h-6 w-6 text-neutral-100 dark:text-neutral-900"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"
          />
        </svg>
        <span class="sr-only">Close</span>
      </button>
      <p class="text-base font-medium text-black dark:text-white">
        {card.category}
      </p>
      <p class="text-2xl md:text-5xl font-semibold text-neutral-700 mt-4 dark:text-white">
        {card.title}
      </p>
      <div class="py-10">
        <slot />
      </div>
    </div>
  </div>
</div>

<script>
  function isMobile() {
    return window.innerWidth < 768;
  }

  document
    .querySelectorAll<HTMLElement>("[data-card-wrapper]")
    .forEach((wrapper) => {
      const openBtn = wrapper.querySelector<HTMLButtonElement>(
        "[data-card-open]",
      );
      const modal = wrapper.querySelector<HTMLElement>("[data-card-modal]");
      const panel = wrapper.querySelector<HTMLElement>(
        "[data-card-modal-panel]",
      );
      const closeBtn = wrapper.querySelector<HTMLButtonElement>(
        "[data-card-close]",
      );
      const scroller = wrapper.closest<HTMLElement>("[data-carousel-scroll]");
      const index = Number(wrapper.dataset.cardIndex ?? 0);
      if (!openBtn || !modal || !panel || !closeBtn) return;

      function onKeyDown(e: KeyboardEvent) {
        if (e.key === "Escape") close();
      }

      function open() {
        modal!.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        document.addEventListener("keydown", onKeyDown);
      }

      function close() {
        modal!.classList.add("hidden");
        document.body.style.overflow = "";
        document.removeEventListener("keydown", onKeyDown);

        if (scroller) {
          const cardWidth = isMobile() ? 230 : 384;
          const gap = isMobile() ? 4 : 8;
          scroller.scrollTo({
            left: (cardWidth + gap) * (index + 1),
            behavior: "smooth",
          });
        }
      }

      openBtn.addEventListener("click", open);
      closeBtn.addEventListener("click", close);
      modal.addEventListener("click", (e) => {
        if (!panel!.contains(e.target as Node)) close();
      });
    });
</script>
